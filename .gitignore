# ==============================================================================
# Git Ignore (.gitignore) - MusicDown Root
# ==============================================================================

# Dependencias de Node y Python
node_modules/
**/node_modules/
backend/venv/
**/venv/
**/.venv/
**/env/
**/ENV/

# Compilación, empaquetado y binarios generados
dist/
**/dist/
build/
**/build/
release/
**/release/
out/
**/out/
squashfs-root/
**/squashfs-root/
*.AppImage
*.exe
*.deb
*.rpm
*.dmg
*.pkg
*.zip
*.tar.gz

# Python bytecode y artefactos de PyInstaller
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.spec

# Binarios externos descargados dinámicamente en runtime
bin/yt-dlp*
**/bin/yt-dlp*
backend/bin/yt-dlp*
*.tmp
.write_probe
.write_test

# Archivos de log
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Configuraciones locales, datos de usuario y descargas
.config/
**/.config/
userData/
**/userData/
descargas/
**/descargas/
downloads/
**/downloads/
temp/
**/temp/
tmp/
**/tmp/

# Variables de entorno y secretos
.env
.env.*
*.env
!.env.example

# Archivos del Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
[Dd]esktop.ini

# Editores e IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
